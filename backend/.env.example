# Server
PORT=8080
ENVIRONMENT=development

# Database
DATABASE_URL=postgres://gamelogger:localdev@localhost:5433/gamelogger?sslmode=disable

# Authentication
SESSION_SECRET=change-this-to-another-secret-in-production
MAGIC_LINK_EXPIRY=15m
SESSION_EXPIRY=720h

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM=noreply@gamelogger.app

# Admin
ADMIN_SECRET=local-dev-secret

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
COOKIE_DOMAIN=localhost

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# WebAuthn / Passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_DISPLAY_NAME=GameLogger
# WEBAUTHN_RP_ORIGINS=http://localhost:3000  (defaults to FRONTEND_URL)
# WEBAUTHN_CHALLENGE_TTL=5m
